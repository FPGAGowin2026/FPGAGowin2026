IO_LOC "motor_in2_o[2]" L3; IO_PORT "motor_in2_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_pwm_o[3]" L4; IO_PORT "motor_pwm_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_in1_o[3]" J2; IO_PORT "motor_in1_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_in2_o[3]" J1; IO_PORT "motor_in2_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_stby_o" C2;   IO_PORT "motor_stby_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "encoder_a_i[0]" B2; IO_PORT "encoder_a_i[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "encoder_b_i[0]" F1; IO_PORT "encoder_b_i[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
