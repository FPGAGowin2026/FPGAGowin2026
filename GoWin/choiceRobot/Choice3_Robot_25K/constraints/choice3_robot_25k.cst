// Tang Primer 25K Core + Dock，GW5A-LV25MG121NC1/I0，Device B。
// 正式 profile：OV5640 + JY61P + TF-Luna + 4路IR + 4路AB编码器 + TB6612。
IO_LOC "clk_50m_i" E2;
IO_PORT "clk_50m_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "reset_i" H11;
IO_PORT "reset_i" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "uart_rx_i" B3;
IO_PORT "uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "uart_tx_o" C3;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// PMOD0：仅约束差分 P 端口，两个封装脚依次为 P/N；N 端由 ELVDS_OBUF 关联。
IO_LOC "tmds_data_p_o[0]" B11,B10;
IO_PORT "tmds_data_p_o[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p_o[1]" D11,D10;
IO_PORT "tmds_data_p_o[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_data_p_o[2]" G11,G10;
IO_PORT "tmds_data_p_o[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_clk_p_o" C11,C10;
IO_PORT "tmds_clk_p_o" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// PMOD1/2：OV5640 8-bit DVP + SCCB。
IO_LOC "ov_data_i[0]" G5;  IO_PORT "ov_data_i[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_data_i[1]" F5;  IO_PORT "ov_data_i[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_data_i[2]" G8;  IO_PORT "ov_data_i[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_data_i[3]" G7;  IO_PORT "ov_data_i[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_data_i[4]" H7;  IO_PORT "ov_data_i[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_data_i[5]" H8;  IO_PORT "ov_data_i[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_data_i[6]" J5;  IO_PORT "ov_data_i[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_data_i[7]" H5;  IO_PORT "ov_data_i[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_pclk_i" L5;     IO_PORT "ov_pclk_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_href_i" K5;     IO_PORT "ov_href_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_vsync_i" K11;   IO_PORT "ov_vsync_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ov_xclk_o" L11;    IO_PORT "ov_xclk_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ov_reset_n_o" E11; IO_PORT "ov_reset_n_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ov_pwdn_o" E10;    IO_PORT "ov_pwdn_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ov_sccb_scl_io" A11; IO_PORT "ov_sccb_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ov_sccb_sda_io" A10; IO_PORT "ov_sccb_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// J3：四电机 TB6612FNG（两块模块，共用 STBY）。
IO_LOC "motor_pwm_o[0]" K1; IO_PORT "motor_pwm_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "motor_in1_o[0]" K2; IO_PORT "motor_in1_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
