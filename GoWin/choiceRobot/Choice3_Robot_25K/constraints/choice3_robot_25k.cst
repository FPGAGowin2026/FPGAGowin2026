IO_LOC "imu_uart_rx_i" L8; IO_PORT "imu_uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "range_uart_rx_i" K10; IO_PORT "range_uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ir_sensor_i[0]" L10; IO_PORT "ir_sensor_i[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ir_sensor_i[1]" K9;  IO_PORT "ir_sensor_i[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ir_sensor_i[2]" L9;  IO_PORT "ir_sensor_i[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ir_sensor_i[3]" K8;  IO_PORT "ir_sensor_i[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "estop_n_i" J8; IO_PORT "estop_n_i" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

IO_LOC "reserve_io[0]" F6; IO_PORT "reserve_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
