// Tang Primer 25K Core + Dock，GW5A-LV25MG121NC1/I0 Device B。
IO_LOC "clk_i" E2;
IO_PORT "clk_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "reset_i" H11;
IO_PORT "reset_i" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "uart_rx_i" B3;
IO_PORT "uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;
IO_LOC "uart_tx_o" C3;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 板载 64 Mbit 配置 Flash；引脚来自 Sipeed 官方核心板原理图。
IO_LOC "flash_qspi_csn" E6;
IO_LOC "flash_qspi_miso" E5;
IO_LOC "flash_qspi_mosi" D6;
IO_LOC "flash_qspi_clk" E7;
IO_LOC "flash_qspi_holdn" E4;
IO_LOC "flash_qspi_wpn" D5;
IO_PORT "flash_qspi_csn" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "flash_qspi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "flash_qspi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "flash_qspi_clk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "flash_qspi_holdn" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "flash_qspi_wpn" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
