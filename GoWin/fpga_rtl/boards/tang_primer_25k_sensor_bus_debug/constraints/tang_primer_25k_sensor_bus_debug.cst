// Tang Primer 25K Core + Dock，器件 GW5A-LV25MG121NC1/I0。
// 时钟、复位和 UART 使用板载固定连接；四组 I2C 使用独立 Dock 3.3 V GPIO。
IO_LOC "clk_i" E2;
IO_PORT "clk_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "reset_i" H11;
IO_PORT "reset_i" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "uart_rx_i" B3;
IO_PORT "uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "uart_tx_o" C3;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// INA219：J3 普通 GPIO。I2C 核只驱动低电平或高阻态。
IO_LOC "ina219_scl_io" G4;
IO_PORT "ina219_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "ina219_sda_io" H2;
IO_PORT "ina219_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// MPU6050
IO_LOC "mpu6050_scl_io" H1;
IO_PORT "mpu6050_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "mpu6050_sda_io" J7;
IO_PORT "mpu6050_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// VL53L0X
IO_LOC "vl53l0x_scl_io" K7;
IO_PORT "vl53l0x_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "vl53l0x_sda_io" L8;
IO_PORT "vl53l0x_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// VL53L1X
IO_LOC "vl53l1x_scl_io" L7;
IO_PORT "vl53l1x_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "vl53l1x_sda_io" K10;
IO_PORT "vl53l1x_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
