// Tang Primer 25K Core + Dock，GW5A-LV25MG121NC1/I0。
// 本工程只使用板载时钟、复位和 USB-UART；传感器端口均为片上连线。
IO_LOC "clk_i" E2;
IO_PORT "clk_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "reset_i" H11;
IO_PORT "reset_i" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "uart_rx_i" B3;
IO_PORT "uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

IO_LOC "uart_tx_o" C3;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
