// ACG720 GW5AT-LV138PG484AC1/I0 pins, taken from the tutorial projects.
IO_LOC "clk_i" Y18;
IO_PORT "clk_i" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "reset_n_i" F15;
IO_PORT "reset_n_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "uart_rx_i" J21;
IO_PORT "uart_rx_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "uart_tx_o" M15;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
