`timescale 1ns/1ps
module DQS (
  output wire DQSR90,
  output wire DQSW0,
  output wire DQSW270,
  output wire [2:0] RPOINT,
  output wire [2:0] WPOINT,
  output wire RVALID,
  output wire RBURST,
  output wire RFLAG,
  output wire WFLAG,
  input  wire DQSIN,
  input  wire [7:0] DLLSTEP,
  input  wire [7:0] WSTEP,
  input  wire [3:0] READ,
  input  wire RLOADN,
  input  wire RMOVE,
  input  wire RDIR,
  input  wire WLOADN,
  input  wire WMOVE,
  input  wire WDIR,
  input  wire HOLD,
  input  wire [2:0] RCLKSEL,
  input  wire PCLK,
  input  wire FCLK,
  input  wire RESET
);
  parameter FIFO_MODE_SEL = 1'b0; // FIFO mode select,1'b0: DDR memory mode;1'b1: GDDR mode //mc1_free_wheel
  parameter RD_PNTR = 3'b000; // FIFO read pointer setting
  parameter DQS_MODE = "X1"; // "X1", "X2_DDR2", "X2_DDR3","X4","X2_DDR3_EXT" //mc1_mode
  parameter HWL = "false";   //"true"; "false" //mc1_updatequ
