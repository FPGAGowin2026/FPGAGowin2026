 170          BOOL DR_SetConfiguration( void )   
 171          { // Called when a Set Configuration command is received
 172   1        
 173   1        if( EZUSB_HIGHSPEED( ) )
 174   1        { // ...FX2 in high speed mode
 175   2          EP6AUTOINLENH = 0x02;
 176   2          SYNCDELAY;
 177   2          EP8AUTOINLENH = 0x02;   // set core AUTO commit len = 512 bytes
 178   2          SYNCDELAY;
 179   2          EP6AUTOINLENL = 0x00;
C51 COMPILER V7.07   SLAVE                                                                 12/31/2020 16:05:31 PAGE 4   

 180   2          SYNCDELAY;
 181   2          EP8AUTOINLENL = 0x00;
 182   2        }
 183   1        else
 184   1        { // ...FX2 in full speed mode
 185   2          EP6AUTOINLENH = 0x00;
 186   2          SYNCDELAY;
 187   2          EP8AUTOINLENH = 0x00;   // set core AUTO commit len = 64 bytes
 188   2          SYNCDELAY;
 189   2          EP6AUTOINLENL = 0x40;
 190   2          SYNCDELAY;
 191   2          EP8AUTOINLENL = 0x40;
 192   2        }
 193   1            
 194   1        Configuration = SETUPDAT[ 2 ];
 195   1        return( TRUE );        // Handled by user code
 196   1      }
