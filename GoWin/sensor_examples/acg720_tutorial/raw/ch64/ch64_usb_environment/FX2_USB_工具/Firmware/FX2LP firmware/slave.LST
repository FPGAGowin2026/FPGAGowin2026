 428          void LED_Off (BYTE LED_Mask)
 429          {
 430   1              if (LED_Mask & bmBIT0)
 431   1              {
 432   2                      ledX_rdvar = LED0_OFF;
 433   2                      LED_State &= ~bmBIT0;
 434   2              }
 435   1              if (LED_Mask & bmBIT1)
 436   1              {
 437   2                      ledX_rdvar = LED1_OFF;
 438   2                      LED_State &= ~bmBIT1;
 439   2              }
 440   1              if (LED_Mask & bmBIT2)
 441   1              {
 442   2                      ledX_rdvar = LED2_OFF;
 443   2                      LED_State &= ~bmBIT2;
 444   2              }
 445   1              if (LED_Mask & bmBIT3)
 446   1              {
 447   2                      ledX_rdvar = LED3_OFF;
 448   2                      LED_State &= ~bmBIT3;
 449   2              }
 450   1      }
 451          
 452          void LED_On (BYTE LED_Mask)
 453          {
 454   1              if (LED_Mask & bmBIT0)
 455   1              {
 456   2                      ledX_rdvar = LED0_ON;
 457   2                      LED_State |= bmBIT0;
 458   2              }
 459   1              if (LED_Mask & bmBIT1)
 460   1              {
 461   2                      ledX_rdvar = LED1_ON;
 462   2                      LED_State |= bmBIT1;
 463   2              }
 464   1              if (LED_Mask & bmBIT2)
 465   1              {
 466   2                      ledX_rdvar = LED2_ON;
 467   2                      LED_State |= bmBIT2;
 468   2              }
 469   1              if (LED_Mask & bmBIT3)
 470   1              {
 471   2                      ledX_rdvar = LED3_ON;
 472   2                      LED_State |= bmBIT3;
 473   2              }
 474   1      }
