// HS源同时保留专用HCLK；fabric控制FF强制走PRIMARY，避免LW偏斜。
CLOCK_LOC "ov5647_capture/camera_dphy_rx/DPHY_RX_INST_HS_CLK" BUFG = CLK;
// 50 MHz 参考输入使用全局时钟路由，避免布局算法退回普通布线。
CLOCK_LOC "clk50m_d" BUFG = CLK;
// BX72 udp 单通信版本；保留原板级引脚映射。
// 启动门控靠近固定 DHCEN 资源，缩短高速半周期控制线；不改变时序要求。
GROUP bx72_dphy_open = {"ov5647_capture/camera_dphy_rx/DPHY_RX_INST_u_idesx8_opensync_0_s0" "ov5647_capture/camera_dphy_rx/DPHY_RX_INST_u_idesx8_opensync_1_s0" "ov5647_capture/camera_dphy_rx/DPHY_RX_INST_u_idesx8_opensync_2_s0" "ov5647_capture/camera_dphy_rx/DPHY_RX_INST_u_idesx8_opensync_3_s0" "ov5647_capture/camera_dphy_rx/DPHY_RX_INST_u_idesx8_LUT4_0" "ov5647_capture/camera_dphy_rx/DPHY_RX_INST_u_idesx8_LUT4_1" "ov5647_capture/camera_dphy_rx/dphy_reset_release_meta_ff" "ov5647_capture/camera_dphy_rx/dphy_reset_release_sync_ff"};
